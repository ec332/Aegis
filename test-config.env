# Test Configuration for Aegis

# Service URLs
API_GATEWAY_URL=http://localhost:8080
TRANSACTION_SERVICE_URL=http://localhost:8081
MARKET_SERVICE_URL=market-service:50051
WALLET_SERVICE_URL=wallet-service:50052
SETTLEMENT_SERVICE_URL=settlement-service:50053

# Test Environment Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Accept,Content-Type,Authorization,X-Request-ID

# Kafka Configuration for Tests
KAFKA_BROKERS=localhost:9092
KAFKA_TEST_TOPIC=test-topic
KAFKA_TEST_GROUP=test-group

# Test Data Configuration
TEST_USER_PREFIX=test-user
TEST_MARKET_PREFIX=test-market
TEST_WALLET_PREFIX=test-wallet
TEST_SETTLEMENT_PREFIX=test-settlement

# Test Timeouts (in seconds)
DEFAULT_TIMEOUT=30
INTEGRATION_TIMEOUT=60
E2E_TIMEOUT=300
CONCURRENT_TEST_TIMEOUT=120

# Performance Test Configuration
CONCURRENT_USERS=10
MAX_CONCURRENT_OPERATIONS=50
BENCHMARK_ITERATIONS=100

# Test Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1
BACKOFF_MULTIPLIER=2

# Health Check Configuration
HEALTH_CHECK_INTERVAL=5
HEALTH_CHECK_TIMEOUT=10
MAX_HEALTH_CHECK_ATTEMPTS=12

# Database Test Configuration (if applicable)
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5432
TEST_DATABASE_NAME=aegis_test
TEST_DATABASE_USER=test_user
TEST_DATABASE_PASSWORD=test_password

# Redis Test Configuration
REDIS_TEST_HOST=localhost
REDIS_TEST_PORT=6379
REDIS_TEST_DB=1

# Logging Configuration
TEST_LOG_LEVEL=info
TEST_LOG_FORMAT=json
ENABLE_TEST_LOGGING=true

# Coverage Configuration
COVERAGE_THRESHOLD=80
COVERAGE_EXCLUDES=vendor,tests,mocks
GENERATE_COVERAGE_REPORT=true

# CI/CD Configuration
CI_PARALLEL_WORKERS=4
CI_TIMEOUT=900
CI_COVERAGE_FORMAT=cobertura

# Mock Configuration
ENABLE_MOCKS=true
MOCK_RESPONSE_DELAY=100
MOCK_FAILURE_RATE=0.1

# Security Test Configuration
TEST_JWT_SECRET=test-jwt-secret-key
TEST_API_KEY=test-api-key
ENABLE_SECURITY_TESTS=true

# Load Test Configuration
LOAD_TEST_DURATION=60
LOAD_TEST_RAMP_UP=10
LOAD_TEST_MAX_REQUESTS_PER_SECOND=100

# Monitoring Test Configuration
ENABLE_METRICS_COLLECTION=true
METRICS_ENDPOINT=http://localhost:9090/metrics
METRICS_COLLECTION_INTERVAL=5